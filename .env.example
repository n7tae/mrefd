# Optional: copy to .env to change any of these defaults
TZ=UTC

# Configuration files on the host
CONFIG_PATH=./mrefd.cfg
BLACKLIST_PATH=./mrefd.blacklist
WHITELIST_PATH=./mrefd.whitelist
INTERLINK_PATH=./mrefd.interlink
DASH_CONFIG_PATH=./php-dash/include/config.inc.php

# UDP port for M17 clients, on the host and in the container.
# It must match Port in mrefd.cfg.
M17_PORT=17000

# Dashboard port on the host
DASHBOARD_PORT=8080

# Images to run. Use your own build with: docker compose build
MREFD_IMAGE=ghcr.io/n7tae/mrefd:latest
MREFD_DASH_IMAGE=ghcr.io/n7tae/mrefd-dash:latest
